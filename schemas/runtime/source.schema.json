{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:source",
  "title": "TRACE-GC source v0.3.0",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security_scope": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "raw_document_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_evidence_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "source_id",
    "version",
    "representation",
    "text",
    "text_hash",
    "security_scope",
    "parser_version",
    "raw_document_hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "representation": {
            "const": "reviewed-image-transcription-v1"
          }
        }
      },
      "then": {
        "required": [
          "image_evidence_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "image_evidence_id"
          ]
        }
      }
    }
  ]
}
