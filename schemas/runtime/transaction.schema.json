{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:transaction",
  "title": "TRACE-GC transaction v0.3.0",
  "type": "object",
  "properties": {
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "before_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification_revision": {
      "type": "integer",
      "minimum": 1
    },
    "classification_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "backend",
    "version",
    "idempotency_key",
    "plan_hash",
    "before_hash",
    "after_hash",
    "previous_hash",
    "event_hash",
    "operation_hash",
    "authorization_hash",
    "preflight_hash",
    "upstream_head",
    "committed_at"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "classification_revision": [
      "classification_hash"
    ],
    "classification_hash": [
      "classification_revision"
    ]
  }
}
