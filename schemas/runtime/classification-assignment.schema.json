{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:classification-assignment",
  "title": "TRACE-GC classification-assignment v0.3.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "trace-research-domain-v1"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "taxonomy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "taxonomy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "domain_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
        "maxLength": 128
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 64
    },
    "state": {
      "enum": [
        "CLASSIFIED",
        "UNCLASSIFIED",
        "RETIRED"
      ]
    },
    "method": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "HUMAN",
            "RULE",
            "MODEL"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "artifact_hash"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "record_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "enum": [
              "SOURCE_TEXT",
              "EVIDENCE_SPAN"
            ]
          }
        },
        "required": [
          "record_id",
          "record_hash",
          "locator"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "effective_graph_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_mode": {
      "enum": [
        "SYNTHETIC",
        "RECORDED",
        "LIVE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_granted": {
      "const": false
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "proposal_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "review_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_version",
    "source_snapshot_id",
    "source_hash",
    "security_scope",
    "source_epoch",
    "taxonomy_id",
    "taxonomy_hash",
    "taxonomy_version",
    "domain_ids",
    "state",
    "method",
    "basis",
    "revision",
    "effective_graph_version",
    "supersedes",
    "supersedes_hash",
    "execution_mode",
    "created_at",
    "authorization_granted",
    "proposal_id",
    "proposal_hash",
    "review_receipt_id",
    "review_receipt_hash",
    "reviewed_approver",
    "reviewed_at"
  ],
  "additionalProperties": false
}
