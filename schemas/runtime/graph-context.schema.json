{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:graph-context",
  "title": "TRACE-GC graph-context v0.3.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_version": {
      "type": "integer",
      "minimum": 0
    },
    "security_scope": {
      "type": "string",
      "minLength": 1
    },
    "access_id": {
      "type": "string",
      "minLength": 1
    },
    "source_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "permission": {
            "enum": [
              "READ",
              "DENIED"
            ]
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "tombstone": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "permission",
          "epoch",
          "updated_at",
          "tombstone"
        ],
        "additionalProperties": false
      }
    },
    "available_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "focus_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "NODE",
              "EDGE",
              "PATH",
              "COMMUNITY",
              "CONFLICT",
              "PROVENANCE",
              "ONTOLOGY",
              "SCHEMA",
              "EVIDENCE",
              "CLAIM",
              "DECISION",
              "HYPOTHESIS"
            ]
          },
          "canonical_ref": {
            "type": "string",
            "minLength": 1
          },
          "member_assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "transaction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "plan_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "record_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "relation_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "text": {
            "type": "string"
          },
          "trust_class": {
            "enum": [
              "VERIFIED_GRAPH_FACT",
              "PROVISIONAL_GRAPH_FACT",
              "DERIVED_GRAPH_FACT",
              "CONFLICTED_GRAPH_FACT",
              "SUPERSEDED_GRAPH_FACT",
              "HISTORICAL_GRAPH_FACT",
              "UNVERIFIED_GRAPH_CONTEXT"
            ]
          },
          "current_status": {
            "type": "string",
            "minLength": 1
          },
          "graph_version": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "superseded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance_complete": {
            "type": "boolean"
          },
          "risk_class": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          },
          "calibration": {
            "type": "object",
            "properties": {
              "qualified": {
                "const": false
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "qualified",
              "note"
            ],
            "additionalProperties": false
          },
          "generated_summary": {
            "type": "boolean"
          },
          "data_origin": {
            "enum": [
              "GENERATED_SUMMARY",
              "SOURCE_DERIVED"
            ]
          },
          "instruction_authority": {
            "const": false
          },
          "research_domain_context": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "object",
                "properties": {
                  "taxonomy_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "taxonomy_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "domain_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "include_unclassified": {
                    "type": "boolean"
                  },
                  "match": {
                    "const": "ANY_EXPLICIT_LABEL"
                  }
                },
                "required": [
                  "taxonomy_id",
                  "taxonomy_hash",
                  "domain_ids",
                  "include_unclassified",
                  "match"
                ],
                "additionalProperties": false
              },
              "scope_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "projection_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "projection_revision": {
                "type": "integer",
                "minimum": 0
              },
              "anchor_assertion_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "closure_assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assertion_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "predicate": {
                      "type": "string",
                      "minLength": 1
                    },
                    "object": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qualifiers": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "assertion_id",
                    "subject",
                    "predicate",
                    "object",
                    "qualifiers",
                    "evidence_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "source_memberships": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "CLASSIFIED",
                        "UNCLASSIFIED",
                        "RETIRED"
                      ]
                    },
                    "domain_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "assignment_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "assignment_hash": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "assignment_revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "taxonomy_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "taxonomy_hash": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "taxonomy_version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "projection_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "projection_revision": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "state",
                    "domain_ids",
                    "assignment_id",
                    "assignment_hash",
                    "assignment_revision",
                    "taxonomy_id",
                    "taxonomy_hash",
                    "taxonomy_version",
                    "projection_hash",
                    "projection_revision"
                  ],
                  "additionalProperties": false
                }
              },
              "authorization_granted": {
                "const": false
              }
            },
            "required": [
              "scope",
              "scope_hash",
              "projection_hash",
              "projection_revision",
              "anchor_assertion_ids",
              "closure_assertions",
              "source_memberships",
              "authorization_granted"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "canonical_ref",
          "member_assertion_ids",
          "assertion_ids",
          "entity_ids",
          "evidence_ids",
          "source_ids",
          "decision_ids",
          "observation_ids",
          "transaction_ids",
          "plan_ids",
          "record_refs",
          "relation_types",
          "text",
          "trust_class",
          "current_status",
          "graph_version",
          "created_at",
          "superseded_at",
          "provenance_complete",
          "risk_class",
          "calibration",
          "generated_summary",
          "data_origin",
          "instruction_authority"
        ],
        "additionalProperties": false
      }
    },
    "retrieved_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retrieved_edges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retrieved_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ontology_fragments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "schema_fragments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conflict_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "temporal_scope": {
      "type": "object",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_source": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "as_of",
        "valid_at",
        "before_source"
      ],
      "additionalProperties": false
    },
    "retrieval_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "strategy_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ranking_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "selected_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retrieval_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reranking_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reranking_base_context_id": {
      "type": "string",
      "minLength": 1
    },
    "research_domain_binding": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "taxonomy_id": {
              "type": "string",
              "minLength": 1
            },
            "taxonomy_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domain_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "include_unclassified": {
              "type": "boolean"
            },
            "match": {
              "const": "ANY_EXPLICIT_LABEL"
            }
          },
          "required": [
            "taxonomy_id",
            "taxonomy_hash",
            "domain_ids",
            "include_unclassified",
            "match"
          ],
          "additionalProperties": false
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scope",
        "scope_hash",
        "projection_hash",
        "projection_revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "query_id",
    "snapshot_id",
    "graph_version",
    "security_scope",
    "access_id",
    "source_status",
    "available_record_ids",
    "focus_entities",
    "items",
    "retrieved_nodes",
    "retrieved_edges",
    "retrieved_paths",
    "communities",
    "ontology_fragments",
    "schema_fragments",
    "provenance_refs",
    "decision_refs",
    "conflict_refs",
    "temporal_scope",
    "retrieval_methods",
    "strategy_versions",
    "ranking_scores",
    "selected_evidence_ids",
    "retrieval_fingerprint",
    "embedding_version",
    "adapter_version",
    "created_at"
  ],
  "additionalProperties": false
}
