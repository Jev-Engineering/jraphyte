{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:retrieval-replay",
  "title": "TRACE-GC retrieval-replay v0.3.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "original_result_id": {
      "type": "string",
      "minLength": 1
    },
    "replayed_result_id": {
      "type": "string",
      "minLength": 1
    },
    "changed_parameters": {
      "type": "object"
    },
    "original_graph_version": {
      "type": "integer",
      "minimum": 0
    },
    "replayed_graph_version": {
      "type": "integer",
      "minimum": 0
    },
    "original_selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "replayed_selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "added_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "removed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "observation_hashes_preserved": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "new_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "synthesis_comparison": {
      "type": "object"
    },
    "authorization_granted": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_classification_identity": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "migrated": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "revision",
        "hash",
        "migrated"
      ],
      "additionalProperties": false
    },
    "replayed_classification_identity": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "migrated": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "revision",
        "hash",
        "migrated"
      ],
      "additionalProperties": false
    },
    "original_research_domain_scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": 1
            },
            "taxonomy_id": {
              "type": "string",
              "minLength": 1
            },
            "taxonomy_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domain_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^research:[a-z0-9][a-z0-9._-]*$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "match": {
              "enum": [
                "ANY",
                "ALL"
              ]
            },
            "include_unclassified": {
              "type": "boolean"
            },
            "include_descendants": {
              "type": "boolean"
            },
            "conflict_resolution": {
              "enum": [
                "literal-v1",
                "authorized-identity-v1"
              ]
            }
          },
          "required": [
            "contract_version",
            "taxonomy_id",
            "taxonomy_hash",
            "domain_ids",
            "match",
            "include_unclassified",
            "include_descendants"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "replayed_research_domain_scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": 1
            },
            "taxonomy_id": {
              "type": "string",
              "minLength": 1
            },
            "taxonomy_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domain_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^research:[a-z0-9][a-z0-9._-]*$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "match": {
              "enum": [
                "ANY",
                "ALL"
              ]
            },
            "include_unclassified": {
              "type": "boolean"
            },
            "include_descendants": {
              "type": "boolean"
            },
            "conflict_resolution": {
              "enum": [
                "literal-v1",
                "authorized-identity-v1"
              ]
            }
          },
          "required": [
            "contract_version",
            "taxonomy_id",
            "taxonomy_hash",
            "domain_ids",
            "match",
            "include_unclassified",
            "include_descendants"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "original_result_id",
    "replayed_result_id",
    "changed_parameters",
    "original_graph_version",
    "replayed_graph_version",
    "original_selected_ids",
    "replayed_selected_ids",
    "added_ids",
    "removed_ids",
    "observation_hashes_preserved",
    "new_observation_ids",
    "synthesis_comparison",
    "authorization_granted",
    "created_at"
  ],
  "additionalProperties": false
}
