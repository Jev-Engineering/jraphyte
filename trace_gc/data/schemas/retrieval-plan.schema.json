{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace-gc:0.3.0:retrieval-plan",
  "title": "TRACE-GC retrieval-plan v0.3.0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "question_type": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "known_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_relations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval_history": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy": {
            "enum": [
              "ENTITY",
              "LEXICAL",
              "VECTOR",
              "NEIGHBORHOOD",
              "PATH",
              "COMMUNITY",
              "GLOBAL",
              "ONTOLOGY",
              "SCHEMA",
              "RELATION",
              "PROVENANCE",
              "EVIDENCE",
              "CONFLICT",
              "DECISION",
              "TEMPORAL",
              "SOURCE",
              "SIMILAR_CASE",
              "CLAIM"
            ]
          },
          "max_hops": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "strategy",
          "max_hops"
        ],
        "additionalProperties": false
      }
    },
    "expansion_policy": {
      "const": "ON_UNCERTAINTY"
    },
    "budget": {
      "type": "object",
      "properties": {
        "maximum_hops": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_paths": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_edges": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_communities": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_provenance_depth": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_source_spans": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_semantic_items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maximum_hops",
        "maximum_paths",
        "maximum_nodes",
        "maximum_edges",
        "maximum_communities",
        "maximum_provenance_depth",
        "maximum_decisions",
        "maximum_source_spans",
        "maximum_tokens",
        "maximum_latency_ms",
        "maximum_cost_units",
        "maximum_candidates",
        "maximum_rounds",
        "maximum_semantic_items"
      ],
      "additionalProperties": false
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_domain_scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contract_version": {
              "const": 1
            },
            "taxonomy_id": {
              "type": "string",
              "minLength": 1
            },
            "taxonomy_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "domain_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^research:[a-z0-9][a-z0-9._-]*$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "match": {
              "enum": [
                "ANY",
                "ALL"
              ]
            },
            "include_unclassified": {
              "type": "boolean"
            },
            "include_descendants": {
              "type": "boolean"
            }
          },
          "required": [
            "contract_version",
            "taxonomy_id",
            "taxonomy_hash",
            "domain_ids",
            "match",
            "include_unclassified",
            "include_descendants"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "candidate_id",
    "question_type",
    "risk_class",
    "known_entities",
    "known_relations",
    "uncertainty",
    "retrieval_history",
    "tier",
    "steps",
    "expansion_policy",
    "budget",
    "policy_version",
    "created_at"
  ],
  "additionalProperties": false
}
